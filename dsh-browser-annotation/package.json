{
  "name": "dsh-browser-annotation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Annotate elements in the built-in DSH side browser with numbered markers and send exact locators to the chat.",
  "license": "MIT",
  "keywords": [
    "deepseek",
    "dsh",
    "deepseek-harness",
    "plugin",
    "browser",
    "annotation",
    "ui"
  ],
  "author": "Enterdada",
  "repository": {
    "type": "git",
    "url": "https://github.com/Enterdada/dsh-browser-annotation.git"
  },
  "homepage": "https://github.com/Enterdada/dsh-browser-annotation#readme",
  "bugs": {
    "url": "https://github.com/Enterdada/dsh-browser-annotation/issues"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
